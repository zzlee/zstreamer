+int rtcSetTrackInterceptorCallback(int tr, rtcInterceptorCallbackFunc cb) {
+	return wrap([&] {
+		auto track = getTrack(tr);
+
+		if (cb == nullptr) {
+			return RTC_ERR_INVALID;
+		}
+
+		auto interceptor = std::make_shared<MediaInterceptor>(nullptr, [tr, cb](void *data, int size) {
+			if (auto ptr = getUserPointer(tr))
+				return cb(tr, reinterpret_cast<const char *>(data), size, *ptr);
+			return data;
+		});
+
+		track->chainMediaHandler(interceptor);
+
+		return RTC_ERR_SUCCESS;
+	});
+}
