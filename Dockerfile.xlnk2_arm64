FROM qcap-build:xlnk2_arm64-base

# ── Copy source & build ─────────────────────────────────────────────────
WORKDIR /workspace
COPY . .

# Use bash so we can source the environment script
SHELL ["/bin/bash", "-c"]

RUN source /opt/qcap-dev-init && \
    unset PKG_CONFIG_SYSROOT_DIR && \
    export PKG_CONFIG_PATH=/opt/qcap/qcap-3rdparty/xlnk2_arm64/lib/pkgconfig:${SDKTARGETSYSROOT}/usr/lib/pkgconfig && \
    mkdir -p build && cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTS=OFF \
        -DENABLE_PLUGINS=OFF \
        -DENABLE_MONOLITHIC=ON \
        -DENABLE_DANTE_DEP=ON \
        -DENABLE_DANTE=ON \
        -DCMAKE_PREFIX_PATH=/opt/qcap/qcap-3rdparty/xlnk2_arm64 \
        -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=BOTH \
        -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=BOTH \
        -DCMAKE_FIND_ROOT_PATH_MODE_PACKAGE=BOTH \
    && make -j$(nproc)
