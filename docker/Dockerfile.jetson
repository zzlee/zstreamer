FROM nvcr.io/nvidia/l4t-base:r32.7.1 AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV QEMU_STACK_SIZE=16777216

# ── Build dependencies ──────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    gnupg \
    ca-certificates \
    && wget -O - https://apt.kitware.com/keys/kitware-archive-latest.asc 2>/dev/null | gpg --dearmor - | tee /usr/share/keyrings/kitware-archive-keyring.gpg >/dev/null \
    && echo 'deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ bionic main' | tee /etc/apt/sources.list.d/kitware.list >/dev/null \
    && apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*


# ── Multimedia libraries (for element plugins) ──────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    libv4l-dev \
    libx264-dev \
    libavformat-dev \
    libavcodec-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libasound2-dev \
    libfreetype6-dev \
    libgnutls28-dev \
    nettle-dev \
    libvulkan-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# ── Compile SRT (not packaged in Ubuntu 18.04/bionic) ───────────────────
RUN git clone --depth 1 https://github.com/Haivision/srt.git /tmp/srt && \
    cd /tmp/srt && \
    mkdir build && cd build && \
    cmake -DUSE_ENCLIB=gnutls -DENABLE_SHARED=ON -DENABLE_STATIC=OFF -DENABLE_UNITTESTS=OFF -DENABLE_APPS=OFF .. && \
    make -j2 && \
    make install && \
    ldconfig && \
    rm -rf /tmp/srt

# Jetson specifically needs multimedia API packages if available, but l4t-base should have nvbuf_utils.

# ── Copy source & build ─────────────────────────────────────────────────
WORKDIR /workspace
COPY . .

RUN mkdir -p build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Debug -DBUILD_TESTS=ON -DENABLE_JETSON=ON && \
    make -j2

FROM base AS ci
WORKDIR /workspace/build
CMD ["ctest", "--output-on-failure"]
